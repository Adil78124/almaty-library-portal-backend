PORT=4000
# Единый файл SQLite с Next.js: путь относительно backend/prisma/ (см. Prisma docs).
DATABASE_URL="file:../../frontend/web/prisma/dev.db"
# Обязательно тот же SESSION_SECRET, что в frontend/web/.env (JWT cookie admin_session).
SESSION_SECRET=dev-only-secret-min-32-chars!!
# Опционально для prisma db seed — главный SUPER_ADMIN (иначе см. значения по умолчанию в prisma/seed.ts).
# SEED_SUPERADMIN_LOGIN=
# SEED_SUPERADMIN_EMAIL=
# SEED_SUPERADMIN_PASSWORD=
# SEED_SUPERADMIN_NAME=
# Папка для загрузок (путь относительно каталога backend/ или абсолютный).
# По умолчанию: ../frontend/web/public/uploads
# UPLOAD_DIR=../frontend/web/public/uploads
